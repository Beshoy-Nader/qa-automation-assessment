# Copy this file to .env and fill in actual values
# .env should be added to .gitignore and NEVER committed

# UI Testing Credentials
SAUCE_DEMO_USERNAME=standard_user
SAUCE_DEMO_PASSWORD=secret_sauce

# API Testing
API_BASE_URL=https://api.restful-api.dev

# Test Environment (staging or production)
TEST_ENV=production

# Reporting
REPORT_FORMAT=html
